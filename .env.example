# ==========================================
# SAPORI CAFE - ENVIRONMENT TEMPLATE
# Copy this file to .env.local and fill in real values
# ==========================================

# Base URL & Brand Information
NEXT_PUBLIC_APP_URL=https://saporicafe.in
NEXT_PUBLIC_BRAND_NAME="SAPORI CAFE"
NEXT_PUBLIC_BRAND_PHONE="+91 63673 73302"
NEXT_PUBLIC_BRAND_ADDRESS="217/1, Ramgali Number 1, Near Panchwati Circle, Raja Park, Jaipur, Rajasthan, India"

# Authentication & Sessions
AUTH_SECRET=your_jwt_auth_secret_here

# Cloudinary CDN & Image Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# MongoDB Atlas Database Credentials
MONGODB_USER=your_mongodb_username
MONGODB_PASS=your_mongodb_password
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/sapori_cafe?retryWrites=true&w=majority

# ==========================================
# FIREBASE CLOUD MESSAGING & PUSH ALARM
# ==========================================
FIREBASE_PROJECT_ID=sapori-cafe
FIREBASE_CLIENT_EMAIL=your_service_account_email@sapori-cafe.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL="https://sapori-cafe-default-rtdb.firebaseio.com"

# Public Firebase Web Push & Client Config
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sapori-cafe.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sapori-cafe
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sapori-cafe.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=254068889011
NEXT_PUBLIC_FIREBASE_APP_ID=1:254068889011:web:...
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-2WCQJ9F8QG
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BM6PR...

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
